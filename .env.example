# MySQL connection string (Laragon default host/port)
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/nyeri_voting"

# Public origin where this Next.js app is reachable
NEXT_PUBLIC_APP_URL="https://your-public-domain.example"

# ------------------------------------------------------------------------------
# Payment Provider Selection: "payhero" (recommended) or "daraja"
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="payhero"

# PayHero Kenya Credentials (https://app.payhero.co.ke)
# Set your API token/key from PayHero Dashboard -> API Keys
# (Alternatively, you can provide PAYHERO_API_USERNAME and PAYHERO_API_PASSWORD)
PAYHERO_API_KEY=""
PAYHERO_API_USERNAME=""
PAYHERO_API_PASSWORD=""

# Payment Channel ID from your PayHero dashboard (e.g. your Till or Paybill channel)
PAYHERO_CHANNEL_ID=""

# PayHero provider (defaults to "m-pesa")
PAYHERO_PROVIDER="m-pesa"

# Webhook Callback configuration for PayHero
PAYHERO_CALLBACK_TOKEN="replace-with-at-least-32-random-characters"
PAYHERO_CALLBACK_URL="https://your-public-domain.example/api/payhero/callback?token=replace-with-at-least-32-random-characters"

# ------------------------------------------------------------------------------
# Direct Safaricom Daraja credentials (optional alternative if not using PayHero)
# ------------------------------------------------------------------------------
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CALLBACK_TOKEN="replace-with-a-long-random-secret"
MPESA_CALLBACK_URL="https://your-public-domain.example/api/mpesa/callback?token=replace-with-a-long-random-secret"

# ------------------------------------------------------------------------------
# Paystack (Card / International Diaspora Payments - Visa, Mastercard, Apple Pay)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CURRENCY="USD"
PAYSTACK_MIN_AMOUNT_USD="2"

# ------------------------------------------------------------------------------
# Security, Admin & Cloud Storage
# ------------------------------------------------------------------------------
# Admin session signing secret (generate with: openssl rand -base64 48)
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_BOOTSTRAP_EMAIL="josephkingangi43@gmail.com"
ADMIN_BOOTSTRAP_PASSWORD="41308970Joe"

# Cloudinary image storage for nominee portraits (optional until uploads are used)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis REST credentials for serverless-safe rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
