# Set these in your Vercel/Netlify/Hosting project settings; never commit real credentials.
NODE_ENV="production"

# MySQL-compatible managed database connection (TLS required in production).
DATABASE_URL="mysql://USER:PASSWORD@MYSQL_HOST:3306/DATABASE?sslaccept=strict"

# Public HTTPS app origin
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# ------------------------------------------------------------------------------
# Payment Provider Selection: "payhero" (recommended) or "daraja"
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="payhero"

# PayHero Kenya Credentials (https://app.payhero.co.ke)
PAYHERO_API_KEY=""
PAYHERO_API_USERNAME=""
PAYHERO_API_PASSWORD=""
PAYHERO_CHANNEL_ID=""
PAYHERO_PROVIDER="m-pesa"
PAYHERO_CALLBACK_TOKEN="REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"
PAYHERO_CALLBACK_URL="https://your-domain.example/api/payhero/callback?token=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"

# ------------------------------------------------------------------------------
# Direct Safaricom Daraja credentials (alternative fallback)
# ------------------------------------------------------------------------------
MPESA_BASE_URL="https://api.safaricom.co.ke"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CALLBACK_TOKEN="REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"
MPESA_CALLBACK_URL="https://your-domain.example/api/mpesa/callback?token=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"

# ------------------------------------------------------------------------------
# Paystack (Card / International Diaspora Payments - Visa, Mastercard, Apple Pay)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CURRENCY="USD"
PAYSTACK_MIN_AMOUNT_USD="2"

# ------------------------------------------------------------------------------
# Security, Admin & Cloud Storage
# ------------------------------------------------------------------------------
# Admin session signing (openssl rand -base64 48; minimum 32 characters).
JWT_SECRET=""

# Shared serverless-safe STK rate limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Required only for nominee portrait uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
